<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Slots Section -->
        <TextView
            android:text="Slot Status"
            android:textSize="20sp"
           android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Parking Slots -->
        <TextView
            android:text="Parking Slots"
           android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TableLayout
            android:id="@+id/parkingTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/corner"
            android:stretchColumns="*"
            android:paddingBottom="12dp" />

        <!-- Sauna Slots -->
        <TextView
            android:text="Sauna Slots"
           android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TableLayout
            android:id="@+id/saunaTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/corner"
            android:stretchColumns="*"
            android:paddingBottom="12dp" />

        <!-- Locker Slots -->
        <TextView
            android:text="Locker Slots"
           android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TableLayout
            android:id="@+id/lockerTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/corner"
            android:stretchColumns="*"
            android:paddingBottom="12dp" />

        <!-- Reservation Section -->
        <TextView
            android:text="Reservations"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Parking Reservations -->
        <TextView
            android:text="Parking Reservations"
           android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TableLayout
            android:id="@+id/parkingReservationsTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/corner"
            android:stretchColumns="*"
            android:paddingBottom="12dp" />

        <!-- Sauna Reservations -->
        <TextView
            android:text="Sauna Reservations"
           android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TableLayout
            android:id="@+id/saunaReservationsTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/corner"
            android:stretchColumns="*"
            android:paddingBottom="12dp" />

        <!-- Locker Reservations -->
        <TextView
            android:text="Locker Reservations"
           android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TableLayout
            android:id="@+id/lockerReservationsTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/corner"
            android:stretchColumns="*"
            android:paddingBottom="24dp" />

    </LinearLayout>
</ScrollView>
