<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:fillViewport="true"
    android:background="@drawable/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gym Subscriptions"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Silver Subscription Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#c0c0c0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Plan Image -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:src="@drawable/subs"
                    android:contentDescription="Silver Plan"
                    android:scaleType="centerCrop"
                    android:layout_marginBottom="16dp"/>

                <!-- Subscription Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Silver Plan"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- Subscription Price -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹799/month"
                    android:textSize="18sp"
                    android:textColor="#000000"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"/>

                <!-- Discounted Prices -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹1899 for 3 months\n₹2700 for 6 months\n₹4200 for 12 months"
                    android:textSize="16sp"
                    android:textColor="#FF6347"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp"/>

                <!-- Subscription Features -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Access to basic gym facilities\n• No personal trainer\n• Limited group classes"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:layout_marginBottom="16dp" />

                <!-- Buy Now Button -->
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Buy Now"
                    android:id="@+id/silverBuyNowButton"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#808080"
                    android:padding="12dp"
                    android:onClick="onBuyNowClicked" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Gold Subscription Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#F0D000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Plan Image -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:src="@drawable/subs"
                    android:contentDescription="Gold Plan"
                    android:scaleType="centerCrop"
                    android:layout_marginBottom="16dp"/>

                <!-- Subscription Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gold Plan"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- Subscription Price -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹1099/month"
                    android:textSize="18sp"
                    android:textColor="#000000"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"/>

                <!-- Discounted Prices -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹2799 for 3 months\n₹4400 for 6 months\n₹7400 for 12 months"
                    android:textSize="16sp"
                    android:textColor="#FF6347"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp"/>

                <!-- Subscription Features -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Access to all gym facilities\n• 1 personal training session/week\n• Unlimited group classes"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:layout_marginBottom="16dp" />

                <!-- Buy Now Button -->
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Buy Now"
                    android:id="@+id/goldBuyNowButton"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FFA500"
                    android:padding="12dp"
                    android:onClick="onBuyNowClicked" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Platinum Subscription Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#B9B4E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Plan Image -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:src="@drawable/subs"
                    android:contentDescription="Platinum Plan"
                    android:scaleType="centerCrop"
                    android:layout_marginBottom="16dp"/>

                <!-- Subscription Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Platinum Plan"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- Subscription Price -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹1499/month"
                    android:textSize="18sp"
                    android:textColor="#000000"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"/>

                <!-- Discounted Prices -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹3299 for 3 months\n₹5100 for 6 months\n₹9600 for 12 months"
                    android:textSize="16sp"
                    android:textColor="#FF6347"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp"/>

                <!-- Subscription Features -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Access to all gym facilities\n• 3 personal training sessions/week\n• Unlimited group classes\n• Free locker access"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:layout_marginBottom="16dp" />

                <!-- Buy Now Button -->
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Buy Now"
                    android:id="@+id/platinumBuyNowButton"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#C0C0C0"
                    android:padding="12dp"
                    android:onClick="onBuyNowClicked" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
