                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Wed, Sat | 7:00 PM - 8:00 PM"
                        android:textColor="@color/secondary_text"/>

                </LinearLayout>

                <LinearLayout
